# 复制为 backend/.env 并填入真实值（.env 已被 .gitignore 忽略）
PORT=3000

# JWT 签名密钥：务必设置为足够长的随机串（>=16位）。
# 若不设置，后端会首次启动自动生成随机密钥并写入 backend/.jwt_secret（同样被忽略）。
# 生产多实例/重启一致性：请通过环境变量或 .env 显式固定。
JWT_SECRET=please-set-a-long-random-secret-at-least-32-chars

JWT_EXPIRES_IN=7d

# 第三方服务密钥（对应 config.js 从 process.env 读取的项）
# 高德开放平台 Web 服务 Key
AMAP_KEY=
# 腾讯位置服务 Key（街景等）
TENCENT_LBS_KEY=
# 火山方舟/豆包大模型 API Key
ARK_API_KEY=
# 联通智慧足迹 API Key
SMARTSTEPS_API_KEY=
