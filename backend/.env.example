# 复制为 backend/.env 并填入真实值（.env 已被 .gitignore 忽略）
PORT=3000

# JWT 签名密钥：务必设置为足够长的随机串（>=16位）。
# 若不设置，后端会首次启动自动生成随机密钥并写入 backend/.jwt_secret（同样被忽略）。
# 生产多实例/重启一致性：请通过环境变量或 .env 显式固定。
JWT_SECRET=please-set-a-long-random-secret-at-least-32-chars

JWT_EXPIRES_IN=7d

# 第三方服务密钥（对应 config.js 从 process.env 读取的项）
# 高德开放平台 Web 服务 Key
AMAP_KEY=
# 腾讯位置服务 Key（街景等）
TENCENT_LBS_KEY=
# 火山方舟/豆包大模型 API Key
ARK_API_KEY=
# 联通智慧足迹 API Key
SMARTSTEPS_API_KEY=

# 分享链接签名密钥（随机长串；不配置则分享功能整体禁用）
PURCHASE_SHARE_SECRET=

# ===== 邮件推送（阿里云 DirectMail）—— 用于「忘记密码」自助重置 =====
# 发信地址：控制台「发信地址」里创建，形如 no-reply@mka-online.cn
SMTP_HOST=smtpdm.aliyun.com
# ⚠️ 阿里云 ECS 默认封禁 TCP 25 端口出方向，必须用 465(SSL)
SMTP_PORT=465
SMTP_USER=no-reply@mka-online.cn
# 控制台「发信地址 → 设置 SMTP 密码」里设的专用密码（不是阿里云账号密码）
SMTP_PASS=
# 邮件里的发件人显示名
MAIL_FROM_NAME=选址赢家Online
# 邮件中重置链接的前缀（本地验证可改为 http://127.0.0.1:4173）
APP_BASE_URL=https://mka-online.cn
